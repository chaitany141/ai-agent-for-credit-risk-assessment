# ============================================================================
# Docker Environment Configuration
# ============================================================================
# Use this file when running with Docker Compose
# Docker Compose will automatically inject these values via environment:

# MongoDB Configuration
MONGO_URI=mongodb://admin:admin_password@mongodb:27017
MONGODB_DB_NAME=loan_agent_db

# Application Settings
USE_LOCAL_LLM=true
OPENAI_API_KEY=

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Risk Thresholds
THRESHOLD_APPROVE=0.4
THRESHOLD_REJECT=0.7

# Plaid Configuration (Optional - leave empty if not used)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Credit Bureau Configuration
# Points to the credit_bureau service within Docker compose
CREDIT_BUREAU_API_URL=http://credit_bureau:8001
CREDIT_BUREAU_API_KEY=mock_api_key_12345

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================================
# Notes:
# - MONGO_URI uses service name 'mongodb' instead of localhost
# - CREDIT_BUREAU_API_URL uses service name 'credit_bureau'
# - All ports use internal Docker network
# - Credentials are for development only - change for production
# ============================================================================
